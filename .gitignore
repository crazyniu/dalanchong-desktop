# AI file map
# Purpose: keep dependency/build output, local data, credentials, and editor artifacts out of Git.
# Entry: Git applies these patterns when determining untracked content.
# Invariant: retain credential/data exclusions and the explicit .vscode exceptions;
# ignoring a path does not authorize deleting its existing contents.

# Local account data, credentials, and scratch work
.env*
!.env.example
*.local
.local/
.work/
*.p12
*.pfx
*.pem
*.key

# Dependencies, generated output, and local exports
node_modules/
.pnpm-store/
/dist/
/dist-release/
/outputs/
/artifacts/
/coverage/
*.tsbuildinfo
.eslintcache
.prettiercache

# Tauri generated files and downloaded browser distribution
/src-tauri/target/
/src-tauri/gen/
/src-tauri/permissions/autogenerated/
/src-tauri/resources/chrome/

# Logs and editor/OS metadata
logs/
*.log
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
._*
Thumbs.db
Desktop.ini
*.suo
*.swp
*.swo
*~
