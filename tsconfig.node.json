/**
 * AI file map
 * Purpose: type-check Vite configuration in its Node-side ES module environment.
 * Entry: referenced by tsconfig.json; include is restricted to vite.config.ts.
 * Invariant: keep Node tooling separate from DOM application code and retain noEmit.
 * This JSONC file configures checking but does not authorize an automatic check/build.
 */

{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["vite.config.ts"]
}
