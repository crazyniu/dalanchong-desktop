{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "platform",
  "description": "平台页面只允许经 Rust 验证的业务回传",
  "webviews": [
    "platform-*",
    "login-*"
  ],
  "remote": {
    "urls": [
      "https://cps.kwaixiaodian.com/*",
      "https://buyin.jinritemai.com/*",
      "https://compass.jinritemai.com/*",
      "https://www.douyin.com/*",
      "https://www.kuaishou.com/*",
      "https://www.kuaishou.cn/*",
      "https://v.kuaishou.com/*",
      "https://live.kuaishou.com/*"
    ]
  },
  "permissions": [
    "allow-platform-result",
    "allow-platform-observe",
    "allow-platform-route"
  ]
}
